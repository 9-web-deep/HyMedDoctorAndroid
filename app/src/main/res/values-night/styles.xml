<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/dark_nav_bg</item>
        <item name="android:colorAccent">@color/primary_light</item>
        <item name="android:buttonStyle">@style/AppButton</item>
        <item name="android:editTextStyle">@style/AppEditText</item>
        <item name="android:windowBackground">@color/dark_bg</item>
    </style>

    <style name="AppButton" parent="android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="AppEditText" parent="android:style/Widget.Material.EditText">
        <item name="android:textCursorDrawable">@null</item>
    </style>
</resources>
